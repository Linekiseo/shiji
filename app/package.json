{
  "name": "shiji",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174",
    "build": "tsc && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "android:sync": "npm run build && cap sync android",
