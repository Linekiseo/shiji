    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "^8.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
